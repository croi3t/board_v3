<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>一括採血データ取得ツール（期間空欄対応版）</title>
<hta:application id="oHTA" border="dialog" innerborder="no" scroll="yes" contextmenu="yes" />
<script language="javascript">
var ie = null; 

window.onunload = function() {
    if(ie) { try { ie.Quit(); } catch(e) {} }
};

function trimStr(str) {
    if(!str) return "";
    return str.replace(/^[\s\u3000]+|[\s\u3000]+$/g, "").replace(/\r?\n/g, "");
}

function padDateStr(dateStr) {
    var parts = dateStr.split(/[\/\-]/);
    if (parts.length !== 3) return dateStr;
    var y = parts[0];
    var m = parts[1].length === 1 ? "0" + parts[1] : parts[1];
    var d = parts[2].length === 1 ? "0" + parts[2] : parts[2];
    return y + "/" + m + "/" + d;
}

function getPastDateStr(dateStr, daysToSubtract) {
    var parts = dateStr.split(/[\/\-]/);
    if (parts.length !== 3) return dateStr;
    var d = new Date(parts[0], parts[1] - 1, parts[2]);
    d.setDate(d.getDate() - daysToSubtract);
    var yy = d.getFullYear();
    var mm = d.getMonth() + 1;
    var dd = d.getDate();
    if (mm < 10) mm = "0" + mm;
    if (dd < 10) dd = "0" + dd;
    return yy + "/" + mm + "/" + dd;
}

function addDaysStr(dateStr, daysToAdd) {
    var parts = dateStr.split(/[\/\-]/);
    if (parts.length !== 3) return dateStr;
    var d = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
    d.setDate(d.getDate() + daysToAdd);
    var yy = d.getFullYear();
    var mm = d.getMonth() + 1;
    var dd = d.getDate();
    if (mm < 10) mm = "0" + mm;
    if (dd < 10) dd = "0" + dd;
    return yy + "/" + mm + "/" + dd;
}

// 検索用ID（先頭の0を除いた文字列）
function getSearchId(id) {
    var s = trimStr(String(id));
    s = s.replace(/[０-９]/g, function(m) { return String.fromCharCode(m.charCodeAt(0) - 0xFEE0); });
    s = s.replace(/^0+/, "");
    return s || "0";
}

// 照合用ID（先頭0埋め7桁）
function zeroPadId(id) {
    var s = trimStr(String(id));
    s = s.replace(/[０-９]/g, function(m) { return String.fromCharCode(m.charCodeAt(0) - 0xFEE0); });
    while (s.length < 7) {
        s = "0" + s;
    }
    return s;
}

// 生年月日と基準日から満年齢を算出
function calculateAge(birthDateStr, targetDateStr) {
    if (!birthDateStr || !targetDateStr) return "";
    var bClean = birthDateStr.replace(/[年月]/g, "/").replace(/日/g, "");
    var tClean = targetDateStr.replace(/[年月]/g, "/").replace(/日/g, "");
    var bParts = bClean.split(/[\/\-]/);
    var tParts = tClean.split(/[\/\-]/);
    if (bParts.length !== 3 || tParts.length !== 3) return "";
    var by = parseInt(bParts[0], 10), bm = parseInt(bParts[1], 10), bd = parseInt(bParts[2], 10);
    var ty = parseInt(tParts[0], 10), tm = parseInt(tParts[1], 10), td = parseInt(tParts[2], 10);
    if (isNaN(by) || isNaN(bm) || isNaN(bd) || isNaN(ty) || isNaN(tm) || isNaN(td)) return "";
    var age = ty - by;
    if (tm < bm || (tm === bm && td < bd)) {
        age--;
    }
    return String(age);
}

function isProfileItem(colName) {
    return (colName === "年齢" || colName === "生年月日" || colName === "性別");
}

function isByomeiAllItem(colName) {
    return (colName === "有効病名" || colName === "併存疾患" || colName === "病名一覧" || colName === "病名");
}

function isByomeiSearchItem(colName) {
    if (!colName) return false;
    return (colName.indexOf("病名:") === 0 || colName.indexOf("病名：") === 0 || colName.indexOf("疾患:") === 0 || colName.indexOf("疾患：") === 0);
}

function isByomeiItem(colName) {
    return (isByomeiAllItem(colName) || isByomeiSearchItem(colName));
}

function isMedAllItem(colName) {
    return (colName === "併用薬" || colName === "処方薬" || colName === "内服薬" || colName === "処方" || colName === "注射薬" || colName === "注射");
}

function isMedSearchItem(colName) {
    if (!colName) return false;
    return (colName.indexOf("薬剤:") === 0 || colName.indexOf("薬剤：") === 0 || colName.indexOf("薬:") === 0 || colName.indexOf("薬：") === 0 || colName.indexOf("併用薬:") === 0 || colName.indexOf("併用薬：") === 0);
}

function isMedItem(colName) {
    return (isMedAllItem(colName) || isMedSearchItem(colName));
}

function isHistoryItem(colName) {
    if (!colName) return false;
    return (colName.indexOf("全期間") !== -1 || colName.indexOf("全履歴") !== -1);
}

function normalizeItemName(name) {
    if (!name) return "";
    var s = name;
    var kanaMap = {
        'ｶﾞ':'ガ','ｷﾞ':'ギ','ｸﾞ':'グ','ｹﾞ':'ゲ','ｺﾞ':'ゴ','ｻﾞ':'ザ','ｼﾞ':'ジ','ｽﾞ':'ズ','ｾﾞ':'ゼ','ｿﾞ':'ゾ',
        'ﾀﾞ':'ダ','ﾁﾞ':'ヂ','ﾂﾞ':'ヅ','ﾃﾞ':'デ','ﾄﾞ':'ド','ﾊﾞ':'バ','ﾋﾞ':'ビ','ﾌﾞ':'ブ','ﾍﾞ':'ベ','ﾎﾞ':'ボ',
        'ﾊﾟ':'パ','ﾋﾟ':'ピ','ﾌﾟ':'プ','ﾍﾟ':'ペ','ﾎﾟ':'ポ','ｳﾞ':'ヴ','ｧ':'ァ','ｨ':'ィ','ｩ':'ゥ','ｪ':'ェ','ｫ':'ォ',
        'ｬ':'ャ','ｭ':'ュ','ｮ':'ョ','ｯ':'ッ','ｰ':'ー','ｱ':'ア','ｲ':'イ','ｳ':'ウ','ｴ':'エ','ｵ':'オ',
        'ｶ':'カ','ｷ':'キ','ｸ':'ク','ｹ':'ケ','ｺ':'コ','ｻ':'サ','ｼ':'シ','ｽ':'ス','ｾ':'セ','ｿ':'ソ',
        'ﾀ':'タ','ﾁ':'チ','ﾂ':'ツ','ﾃ':'テ','ﾄ':'ト','ﾅ':'ナ','ﾆ':'ニ','ﾇ':'ヌ','ﾈ':'ネ','ﾉ':'ノ',
        'ﾊ':'ハ','ﾋ':'ヒ','ﾌ':'フ','ﾍ':'ヘ','ﾎ':'ホ','ﾏ':'マ','ﾐ':'ミ','ﾑ':'ム','ﾒ':'メ','ﾓ':'モ',
        'ﾔ':'ヤ','ﾕ':'ユ','ﾖ':'ヨ','ﾗ':'ラ','ﾘ':'リ','ﾙ':'ル','ﾚ':'レ','ﾛ':'ロ','ﾜ':'ワ','ｦ':'ヲ','ﾝ':'ン'
    };
    var reg = new RegExp(Object.keys(kanaMap).join('|'), 'g');
    s = s.replace(reg, function(match){ return kanaMap[match]; });
    s = s.replace(/[Ａ-Ｚａ-ｚ０-９]/g, function(m) { return String.fromCharCode(m.charCodeAt(0) - 0xFEE0); });
    s = s.toUpperCase();
    s = s.replace(/[\s\u3000]+/g, "");

    if (s === "EGFRCREA" || s === "EGFR(CRE)") s = "EGFR"; 
    if (s === "LD(IFCC)" || s === "LDH") s = "LD";   
    if (s === "ALP(IFCC)") s = "ALP"; 
    if (s === "HBA1C(NGSP)" || s === "HBA1C(JDS)") s = "HBA1C"; 
    if (s === "Γ-GTP" || s === "Γ-GT" || s === "ΓGTP" || s === "G-GTP" || s === "G-GT" || s === "GGTP") s = "G-GTP";  
    if (s === "CPK") s = "CK";        
    if (s === "CRE" || s === "CR" || s === "CREA") s = "CREA";
    if (s === "HB" || s === "HGB") s = "HGB";
    if (s === "TBIL" || s === "T.BIL" || s === "T-BIL") s = "T-BIL";
    if (s === "DBIL" || s === "D.BIL" || s === "D-BIL") s = "D-BIL";
    if (s === "GLU" || s === "BS" || s === "GLUCOSE") s = "GLUCOSE";
    
    return s;
}

// 薬効分類・検索キーワード展開辞書の初期値
var DEFAULT_DICT_TEXT = [
    "# 1行に1分類を「見出し語 = 検索語1, 検索語2, ...」の形式で記述します（#で始まる行はコメント）。",
    "# 見出しに「薬剤:フィブラート」「薬剤:ARB」等と入力すると、右辺の全キーワードに自動展開してOR検索します。",
    "# 複数の別名を登録する場合は「DPP4|DPP-4 = ...」のように | で区切ります。病名（病名:〇〇）にも使用可能です。",
    "フィブラート|フィブラート系 = フィブラート, パルモディア, ベザトール, ベザリップ, リピディル, トライコア, リポクリン",
    "スタチン|スタチン系|HMG-CoA = スタチン, クレストール, リピトール, リバロ, メバロチン, リポバス, ローコール, カデュエット, アトーゼット, ロスーゼット, リバゼブ",
    "ARB|アンジオテンシンII受容体拮抗薬 = サルタン, ブロプレス, オルメテック, ミカルディス, ディオバン, アジルバ, ニューロタン, アバプロ, イルベタン, エカード, ユニシア, ミコンビ, ミカムロ, テルチア, コディオ, エックスフォージ, アテディオ, ザクラス, ジルムロ, プレミネント, アイミクス, レザルタス",
    "SGLT2|SGLT-2 = グリフロジン, スーグラ, フォシーガ, ルセフィ, デベルザ, アプルウェイ, カナグル, ジャディアンス, スージャヌ, カナリア, トラディアンス",
    "DPP4|DPP-4 = グリプチン, ジャヌビア, グラクティブ, エクア, ネシーナ, トラゼンタ, テネリア, スイニー, オングリザ, ザファテック, マリゼフ, エクメット, イニシンク, リオベル, グルベス, メトアナ, スージャヌ, カナリア, トラディアンス",
    "PPI|プロトンポンプ阻害薬 = プラゾール, ボノプラザン, オメプラール, オメプラゾン, タケプロン, パリエット, ネキシウム, タケキャブ, タキャプロン, ボノサップ, ボノピオン, ラベキュア, ラベファイン, ランサップ, ランピオン",
    "ビスホスホネート|ビスフォスフォネート|BP = ドロン酸, フォサマック, ボナロン, アクトネル, ベネット, ボノテオ, リカルボン, ボンビバ, ゾメタ, リクラスト, ダイドロネル, アレディア"
].join("\r\n");

var parsedDictMap = {};

function getDictFilePath() {
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var htaPath = unescape(location.pathname);
        if (htaPath.charAt(0) === "/" && htaPath.charAt(2) === ":") {
            htaPath = htaPath.substring(1);
        }
        var folder = fso.GetParentFolderName(htaPath);
        return fso.BuildPath(folder, "drug_dictionary.txt");
    } catch(e) {
        return "drug_dictionary.txt";
    }
}

function loadDictionary() {
    var dictEl = document.getElementById("dictText");
    if (!dictEl) return;
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var path = getDictFilePath();
        if (fso.FileExists(path)) {
            var ts = fso.OpenTextFile(path, 1, false, -1); // -1: Unicode (UTF-16)
            var content = ts.ReadAll();
            ts.Close();
            if (trimStr(content) !== "") {
                dictEl.value = content;
                parseDictionaryMap();
                return;
            }
        }
    } catch(e) {}
    dictEl.value = DEFAULT_DICT_TEXT;
    parseDictionaryMap();
}

function saveDictionary(silent) {
    var dictEl = document.getElementById("dictText");
    if (!dictEl) return;
    parseDictionaryMap();
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var path = getDictFilePath();
        var ts = fso.OpenTextFile(path, 2, true, -1); // 2: ForWriting, true: Create, -1: Unicode
        ts.Write(dictEl.value);
        ts.Close();
        if (!silent) {
            var st = document.getElementById("dictStatus");
            if (st) {
                st.innerText = "✓ 辞書を保存しました（drug_dictionary.txt）";
                setTimeout(function() { if (st) st.innerText = ""; }, 4000);
            }
        }
    } catch(e) {
        if (!silent) {
            alert("辞書ファイルの保存に失敗しました（画面上の編集内容は今回の取得にそのまま反映されます）。");
        }
    }
}

function resetDictionary() {
    if (!confirm("薬効分類・検索辞書を初期状態に戻しますか？")) return;
    var dictEl = document.getElementById("dictText");
    if (dictEl) {
        dictEl.value = DEFAULT_DICT_TEXT;
        saveDictionary(false);
    }
}

function toggleDictPanel() {
    var panel = document.getElementById("dictPanel");
    var btn = document.getElementById("toggleDictBtn");
    if (!panel) return;
    if (panel.style.display === "none" || panel.style.display === "") {
        panel.style.display = "block";
        if (btn) btn.innerText = "▲ 薬効分類・検索辞書を閉じる";
    } else {
        panel.style.display = "none";
        if (btn) btn.innerText = "▼ 薬効分類・検索辞書の確認・編集";
    }
}

function normalizeDictKey(k) {
    var s = normalizeItemName(k);
    // 末尾の「系薬」「阻害薬」「受容体拮抗薬」「製剤」等を除いたキーでも照合できるよう正規化
    return s;
}

function stripClassSuffix(normK) {
    if (!normK) return "";
    return normK.replace(/(?:受容体拮抗薬|受容体拮抗剤|拮抗薬|拮抗剤|阻害薬|阻害剤|系薬剤|系薬|製剤|系|薬|剤)$/, "");
}

function parseDictionaryMap() {
    parsedDictMap = {};
    var dictEl = document.getElementById("dictText");
    var rawText = dictEl ? dictEl.value : DEFAULT_DICT_TEXT;
    var dLines = rawText.split(/\r?\n/);
    for (var i = 0; i < dLines.length; i++) {
        var line = trimStr(dLines[i]);
        if (!line || line.charAt(0) === "#" || line.indexOf("//") === 0) continue;
        var eqIdx = line.indexOf("=");
        if (eqIdx === -1) eqIdx = line.indexOf("＝");
        if (eqIdx === -1) continue;

        var lhs = trimStr(line.substring(0, eqIdx));
        var rhs = trimStr(line.substring(eqIdx + 1));
        if (!lhs || !rhs) continue;

        var keyAliases = lhs.split(/[|｜\/／,、]/);
        var valTokens = rhs.split(/[|｜\/／,、]/);
        var cleanVals = [];
        for (var v = 0; v < valTokens.length; v++) {
            var vt = trimStr(valTokens[v]);
            if (vt) cleanVals.push(vt);
        }
        if (cleanVals.length === 0) continue;

        for (var k = 0; k < keyAliases.length; k++) {
            var ka = trimStr(keyAliases[k]);
            if (!ka) continue;
            var nk = normalizeDictKey(ka);
            if (nk) {
                parsedDictMap[nk] = cleanVals;
                var stripped = stripClassSuffix(nk);
                if (stripped && !parsedDictMap[stripped]) {
                    parsedDictMap[stripped] = cleanVals;
                }
            }
        }
    }
}

// 見出しの検索キーワード（例: "フィブラート" や "ARB|アムロジピン"）を辞書で展開して返す
function expandSearchKeywords(kwPart) {
    var rawKws = kwPart.split(/[|｜\/／,、]/);
    var result = [];
    var seen = {};
    for (var i = 0; i < rawKws.length; i++) {
        var kw = trimStr(rawKws[i]);
        if (!kw) continue;
        var nk = normalizeDictKey(kw);
        var strippedNk = stripClassSuffix(nk);
        var expanded = parsedDictMap[nk] || (strippedNk ? parsedDictMap[strippedNk] : null);
        if (expanded && expanded.length > 0) {
            for (var j = 0; j < expanded.length; j++) {
                var ekw = expanded[j];
                if (!seen[ekw]) {
                    seen[ekw] = true;
                    result.push(ekw);
                }
            }
        } else {
            if (!seen[kw]) {
                seen[kw] = true;
                result.push(kw);
            }
        }
    }
    return result;
}

// IE/HTAの「このページのスクリプトが原因で、Internet Explorer の実行速度が遅くなっています」ダイアログを抑止（管理者権限不要・HKCU）
function disableIeScriptTimeoutWarning() {
    try {
        var wsh = new ActiveXObject("WScript.Shell");
        wsh.RegWrite("HKCU\\Software\\Microsoft\\Internet Explorer\\Styles\\MaxScriptStatements", 0x7FFFFFFF, "REG_DWORD");
    } catch(e) {}
}

window.onload = function() {
    disableIeScriptTimeoutWarning();
    loadDictionary();
};

var lines = [];
var currentLine = 0;
var outputLines = [];
var currentCols = [];
var currentId = "";
var currentTargetDate = "";
var currentRawLine = "";
var targetItems = []; 
var searchDays = ""; // 採血探索期間（初期値空欄）
var medSearchDays = 30; // 併用薬探索期間（初期値30日）
var isPaused = false;
var fetchAgeEnabled = true;
var fetchByomeiEnabled = true;
var excludeSuspectedEnabled = false;
var fetchMedEnabled = true;
var patientInfoCache = {}; // key: 7桁0埋めID -> { found, birthDate, listAge, sex }
var byomeiCache = {};      // key: 7桁0埋めID + "_" + currentTargetDate -> { list: [{name, suspected}], error }
var medOrderCache = {};    // key: 7桁0埋めID -> { shoho: [...], chusha: [...], shohoLoaded, chushaLoaded, shohoError, chushaError }

function updatePreview() {
    var previewText = document.getElementById("previewText");
    var showAll = document.getElementById("showAllPreviewChk") ? document.getElementById("showAllPreviewChk").checked : true;
    if (showAll || outputLines.length <= 5) {
        previewText.value = outputLines.join("\n");
    } else {
        previewText.value = outputLines.slice(0, 5).join("\n") + "\n... (以下省略・全 " + outputLines.length + " 行)";
    }
    var copyBtn = document.getElementById("copyBtn");
    if (copyBtn) {
        copyBtn.disabled = (outputLines.length === 0);
    }
    var countSpan = document.getElementById("previewCount");
    if (countSpan) {
        countSpan.innerText = outputLines.length > 0 ? "（現在 " + outputLines.length + " 行）" : "";
    }
}

function copyResult() {
    if (outputLines.length === 0) {
        alert("コピーする取得結果がありません。");
        return;
    }
    window.clipboardData.setData("Text", outputLines.join("\n"));
    var copyStatus = document.getElementById("copyStatus");
    if (copyStatus) {
        copyStatus.innerText = "✓ クリップボードにコピーしました！（全 " + outputLines.length + " 行）";
        setTimeout(function() {
            if (copyStatus) copyStatus.innerText = "";
        }, 4000);
    }
}

function togglePause() {
    if (!isPaused) {
        isPaused = true;
        document.getElementById("pauseBtn").innerText = "再開";
        document.getElementById("msg").innerText = "一時停止予約中... (現在の行の処理完了後に停止します)";
    } else {
        isPaused = false;
        document.getElementById("btn").disabled = true;
        document.getElementById("pauseBtn").innerText = "一時停止";
        document.getElementById("msg").innerText = "処理を再開します...";
        processNext();
    }
}

function startProcess() {
    var text = document.getElementById("inputText").value;
    if(!text) {
        alert("データを貼り付けてください。");
        return;
    }
    
    // 採血探索期間の取得（空欄ならそのまま空文字、数字があれば数値化）
    var sdVal = document.getElementById("searchDays").value;
    if (sdVal === "") {
        searchDays = "";
    } else {
        searchDays = parseInt(sdVal, 10);
    }
    // 併用薬探索期間の取得
    var msdVal = document.getElementById("medSearchDays").value;
    if (msdVal === "") {
        medSearchDays = "";
    } else {
        medSearchDays = parseInt(msdVal, 10);
    }
    fetchAgeEnabled = document.getElementById("fetchAgeChk").checked;
    fetchByomeiEnabled = document.getElementById("fetchByomeiChk").checked;
    excludeSuspectedEnabled = document.getElementById("excludeSuspectedChk").checked;
    fetchMedEnabled = document.getElementById("fetchMedChk").checked;

    // 画面上の辞書内容を反映・自動保存
    saveDictionary(true);
    disableIeScriptTimeoutWarning();
    
    try {
        if(!ie) {
            ie = new ActiveXObject("InternetExplorer.Application");
            ie.Visible = false;
            try { ie.Silent = true; } catch(e2) {}
        }
    } catch(e) {
        alert("Internet Explorerの起動に失敗しました。");
        return;
    }

    lines = text.split("\n");
    currentLine = 0;
    outputLines = [];
    targetItems = []; 
    byomeiCache = {};
    medOrderCache = {};
    isPaused = false;
    document.getElementById("previewText").value = "";
    if (document.getElementById("copyBtn")) document.getElementById("copyBtn").disabled = true;
    if (document.getElementById("previewCount")) document.getElementById("previewCount").innerText = "";
    if (document.getElementById("copyStatus")) document.getElementById("copyStatus").innerText = "";
    document.getElementById("msg").innerText = "処理を開始します...";
    document.getElementById("btn").disabled = true;
    document.getElementById("pauseBtn").disabled = false;
    document.getElementById("pauseBtn").innerText = "一時停止";
    
    processNext();
}

function hasPatientInfoTarget() {
    for (var i = 0; i < targetItems.length; i++) {
        if (isProfileItem(targetItems[i])) return true;
    }
    return false;
}

function hasByomeiTarget() {
    for (var i = 0; i < targetItems.length; i++) {
        if (isByomeiItem(targetItems[i])) return true;
    }
    return false;
}

function needShohoTarget() {
    for (var i = 0; i < targetItems.length; i++) {
        var c = targetItems[i];
        if (c === "併用薬" || c === "処方薬" || c === "内服薬" || c === "処方" || isMedSearchItem(c)) return true;
    }
    return false;
}

function needChushaTarget() {
    for (var i = 0; i < targetItems.length; i++) {
        var c = targetItems[i];
        if (c === "併用薬" || c === "注射薬" || c === "注射" || isMedSearchItem(c)) return true;
    }
    return false;
}

function hasBloodTestTarget() {
    for (var i = 0; i < targetItems.length; i++) {
        if (!isProfileItem(targetItems[i]) && !isByomeiItem(targetItems[i]) && !isMedItem(targetItems[i])) return true;
    }
    return false;
}

function processNext() {
    if (isPaused) {
        var autoCopyPause = document.getElementById("autoCopyChk") && document.getElementById("autoCopyChk").checked;
        if (autoCopyPause && outputLines.length > 0) {
            window.clipboardData.setData("Text", outputLines.join("\n"));
        }
        document.getElementById("btn").disabled = false;
        document.getElementById("msg").innerText = "一時停止中 (" + currentLine + " / " + lines.length + " 行目まで処理済・「取得結果をコピー」ボタンでコピーできます)";
        return;
    }

    if (currentLine >= lines.length) {
        var autoCopyDone = document.getElementById("autoCopyChk") && document.getElementById("autoCopyChk").checked;
        if (autoCopyDone && outputLines.length > 0) {
            window.clipboardData.setData("Text", outputLines.join("\n"));
            document.getElementById("msg").innerText = "完了しました！（自動コピー済） プレビューを確認し、JUSTcalcに貼り付けてください。";
        } else {
            document.getElementById("msg").innerText = "完了しました！ 「取得結果をコピー」ボタンを押してJUSTcalcに貼り付けてください。";
        }
        document.getElementById("btn").disabled = false;
        document.getElementById("pauseBtn").disabled = true;
        document.getElementById("pauseBtn").innerText = "一時停止";
        try { ie.Quit(); ie = null; } catch(e) {}
        return;
    }

    currentRawLine = lines[currentLine];
    var line = trimStr(currentRawLine);
    currentLine++;

    if (!line) {
        setTimeout(processNext, 10);
        return;
    }

    currentCols = line.split("\t");
    if (currentCols.length < 2) {
        outputLines.push(line + "\tエラー:列不足");
        updatePreview();
        setTimeout(processNext, 10);
        return;
    }

    currentId = trimStr(currentCols[0]);
    var rawTargetDate = trimStr(currentCols[1]); 
    var isDataRow = rawTargetDate.match(/^\d{4}[\/\-]\d{1,2}[\/\-]\d{1,2}$/);

    if (!isDataRow) {
        targetItems = []; 
        var hasAgeInHeader = false;
        var hasByomeiInHeader = false;
        var hasMedInHeader = false;
        for (var k = 2; k < currentCols.length; k++) {
            var cName = trimStr(currentCols[k]);
            if (cName === "年齢") hasAgeInHeader = true;
            if (isByomeiAllItem(cName)) hasByomeiInHeader = true;
            if (isMedAllItem(cName)) hasMedInHeader = true;
        }

        var headerRow = [currentId, rawTargetDate];
        if (fetchAgeEnabled && !hasAgeInHeader) {
            targetItems.push("年齢");
            headerRow.push("年齢");
        }
        if (fetchByomeiEnabled && !hasByomeiInHeader) {
            targetItems.push("有効病名");
            headerRow.push("有効病名");
        }
        if (fetchMedEnabled && !hasMedInHeader) {
            targetItems.push("併用薬");
            headerRow.push("併用薬");
        }
        for (var k = 2; k < currentCols.length; k++) {
            var colName = trimStr(currentCols[k]);
            if (colName && colName !== "採血日" && colName !== "採血値") {
                targetItems.push(colName);
                headerRow.push(colName);
                if (!isProfileItem(colName) && !isByomeiItem(colName) && !isMedItem(colName) && !isHistoryItem(colName)) {
                    headerRow.push("採血日");
                }
            }
        }
        outputLines.push(headerRow.join("\t"));
        updatePreview();
        setTimeout(processNext, 10);
        return;
    }

    if (targetItems.length === 0) {
        if (fetchAgeEnabled) {
            targetItems.push("年齢");
        }
        if (fetchByomeiEnabled) {
            targetItems.push("有効病名");
        }
        if (fetchMedEnabled) {
            targetItems.push("併用薬");
        }
        if (currentCols.length > 2) {
            for (var k = 2; k < currentCols.length; k++) {
                var colName = trimStr(currentCols[k]);
                if (colName && !(fetchAgeEnabled && colName === "年齢") && !(fetchByomeiEnabled && isByomeiAllItem(colName)) && !(fetchMedEnabled && isMedAllItem(colName))) {
                    targetItems.push(colName);
                }
            }
        }
    }

    currentTargetDate = padDateStr(rawTargetDate);
    var paddedId = zeroPadId(currentId);

    // 1. 年齢（生年月日）の取得が必要で、かつ未キャッシュなら患者一覧URLへアクセス
    if (hasPatientInfoTarget() && (!patientInfoCache[paddedId] || patientInfoCache[paddedId].error)) {
        document.getElementById("msg").innerText = currentLine + " 行目を処理中... (ID: " + currentId + " の基本情報を取得中)";
        var searchId = getSearchId(currentId);
        var infoUrl = "http://10.5.171.42:8082/karte/kanja_ichiran/kanja_ichiran.php"
                    + "?kanja_id=" + encodeURIComponent(searchId)
                    + "&ichiran_code=31"
                    + "&user_id=16622"
                    + "&section_code="
                    + "&page_num=0"
                    + "&login_flg="
                    + "&_t=" + new Date().getTime();
        try {
            ie.Navigate(infoUrl);
            setTimeout(waitForInfoLoad, 100);
        } catch(e) {
            patientInfoCache[paddedId] = { found: false, birthDate: "", listAge: "", sex: "", error: true };
            proceedToByomeiOrNext();
        }
        return;
    }

    proceedToByomeiOrNext();
}

function waitForInfoLoad() {
    try {
        if (ie.Busy || ie.readyState !== 4) {
            setTimeout(waitForInfoLoad, 150);
            return;
        }

        var paddedId = zeroPadId(currentId);
        var doc = ie.Document;
        var matchedTds = findPatientRowByExactId(doc, paddedId);

        if (matchedTds) {
            var bdText = trimStr(matchedTds[4].innerText || matchedTds[4].textContent || "");
            var ageText = trimStr(matchedTds[5].innerText || matchedTds[5].textContent || "");
            var sexText = trimStr(matchedTds[6].innerText || matchedTds[6].textContent || "");
            patientInfoCache[paddedId] = {
                found: true,
                birthDate: bdText,
                listAge: ageText,
                sex: sexText
            };
        } else {
            patientInfoCache[paddedId] = {
                found: false,
                birthDate: "",
                listAge: "",
                sex: ""
            };
        }
    } catch(e) {
        var paddedIdErr = zeroPadId(currentId);
        patientInfoCache[paddedIdErr] = { found: false, birthDate: "", listAge: "", sex: "", error: true };
    }

    proceedToByomeiOrNext();
}

// 0埋め7桁IDとの完全一致で行を検索（6桁ID等で複数患者がヒットした場合の誤マッチ防止）
function findPatientRowByExactId(currentDoc, paddedId) {
    if (!currentDoc) return null;
    try {
        var trs = currentDoc.getElementsByTagName("tr");
        for (var i = 0; i < trs.length; i++) {
            var tds = trs[i].getElementsByTagName("td");
            if (tds.length >= 7) {
                var idText = trimStr(tds[2].innerText || tds[2].textContent || "");
                if (idText === paddedId) {
                    return tds;
                }
            }
        }
    } catch(e) {}

    try {
        var frames = currentDoc.getElementsByTagName("frame");
        for (var j = 0; j < frames.length; j++) {
            try {
                var row = findPatientRowByExactId(frames[j].contentWindow.document, paddedId);
                if (row) return row;
            } catch(e) {}
        }
        var iframes = currentDoc.getElementsByTagName("iframe");
        for (var k = 0; k < iframes.length; k++) {
            try {
                var row2 = findPatientRowByExactId(iframes[k].contentWindow.document, paddedId);
                if (row2) return row2;
            } catch(e) {}
        }
    } catch(e) {}

    return null;
}

// 2. 有効病名の取得が必要で、かつ未キャッシュなら病名一覧URLへアクセス
function proceedToByomeiOrNext() {
    var bKey = zeroPadId(currentId) + "_" + currentTargetDate;
    if (hasByomeiTarget() && (!byomeiCache[bKey] || byomeiCache[bKey].error)) {
        document.getElementById("msg").innerText = currentLine + " 行目を処理中... (ID: " + currentId + " の有効病名を取得中)";
        var byomeiUrl = "http://10.5.171.42:8082/karte/kanja_profile/parts/kanja_byomei_info_disp.php"
                      + "?kanja_id=" + encodeURIComponent(currentId)
                      + "&user_id=16622"
                      + "&section_code=0000022"
                      + "&disp_start_date=" + currentTargetDate
                      + "&disp_end_date=" + currentTargetDate
                      + "&shindan_kind=2"
                      + "&mysection_flg=1"
                      + "&disp_range_kind=1"
                      + "&risk_manage_kind=0"
                      + "&byomei_status_kind=0"
                      + "&_t=" + new Date().getTime();
        try {
            ie.Navigate(byomeiUrl);
            setTimeout(waitForByomeiLoad, 100);
        } catch(e) {
            byomeiCache[bKey] = { list: [], error: true };
            proceedToMedOrNext();
        }
        return;
    }

    proceedToMedOrNext();
}

function waitForByomeiLoad() {
    var bKey = zeroPadId(currentId) + "_" + currentTargetDate;
    try {
        if (ie.Busy || ie.readyState !== 4) {
            setTimeout(waitForByomeiLoad, 150);
            return;
        }

        var doc = ie.Document;
        var list = [];
        // ★高速化: DOMのセルを1つずつCOM経由で読むのではなく、HTMLを一括取得してメモリ内で解析
        var bodyHtml = (doc && doc.body) ? (doc.body.innerHTML || "") : "";
        var trChunks = bodyHtml.split(/<tr\b[^>]*>/i);
        for (var r = 1; r < trChunks.length; r++) {
            var cells = extractRowCellsFromTrHtml(trChunks[r]);
            if (cells.length >= 9) {
                var numTxt = cells[0];
                if (numTxt === "" || numTxt === "番号") continue;

                var byomeiName = cells[3];
                var utagaiTxt = cells[4];
                var tenkiTxt = cells[5];
                var endDateTxt = cells[8];

                if (byomeiName !== "") {
                    var isSuspected = (utagaiTxt === "○" || byomeiName.indexOf("の疑い") !== -1);
                    list.push({
                        name: byomeiName,
                        suspected: isSuspected,
                        tenki: tenkiTxt,
                        endDate: endDateTxt
                    });
                }
            }
        }
        byomeiCache[bKey] = { list: list, error: false };
    } catch(e) {
        byomeiCache[bKey] = { list: [], error: true };
    }

    proceedToMedOrNext();
}

function getByomeiItemValue(colName) {
    var bKey = zeroPadId(currentId) + "_" + currentTargetDate;
    var bData = byomeiCache[bKey];
    if (!bData) return "";
    if (bData.error) return "病名取得エラー";

    // 重複を除きつつ条件に合う病名リストを作成
    var filteredNames = [];
    var seen = {};
    for (var i = 0; i < bData.list.length; i++) {
        var item = bData.list[i];
        if (excludeSuspectedEnabled && item.suspected) {
            continue;
        }
        var dispName = item.name;
        if (!seen[dispName]) {
            seen[dispName] = true;
            filteredNames.push(dispName);
        }
    }

    // 「有効病名」「併存疾患」等の全件出力列の場合
    if (isByomeiAllItem(colName)) {
        if (filteredNames.length === 0) return "登録なし";
        return filteredNames.join(", ");
    }

    // 「病名:糖尿病」や「病名:胃癌|大腸癌」のような個別キーワードサーチ列の場合（辞書による自動展開対応）
    var kwPart = colName.replace(/^(?:病名|疾患)[:：]/, "");
    var keywords = expandSearchKeywords(kwPart);
    var matchedNames = [];
    for (var j = 0; j < filteredNames.length; j++) {
        var dName = filteredNames[j];
        var normDName = normalizeItemName(dName);
        for (var m = 0; m < keywords.length; m++) {
            var kw = trimStr(keywords[m]);
            if (!kw) continue;
            var normKw = normalizeItemName(kw);
            if (dName.indexOf(kw) !== -1 || (normKw && normDName.indexOf(normKw) !== -1)) {
                matchedNames.push(dName);
                break;
            }
        }
    }
    return matchedNames.join(", ");
}

// 3. 併用薬（処方: order_search_code=1 / 注射: order_search_code=4）の取得
function proceedToMedOrNext() {
    var paddedId = zeroPadId(currentId);
    if (!medOrderCache[paddedId]) {
        medOrderCache[paddedId] = {
            shoho: [],
            chusha: [],
            shohoLoaded: false,
            chushaLoaded: false,
            shohoError: false,
            chushaError: false
        };
    }

    if (needShohoTarget() && (!medOrderCache[paddedId].shohoLoaded || medOrderCache[paddedId].shohoError)) {
        document.getElementById("msg").innerText = currentLine + " 行目を処理中... (ID: " + currentId + " の処方歴を取得中)";
        var shohoUrl = "http://10.5.171.42:8082/karte/karte.php"
                     + "?kanja_id=" + encodeURIComponent(currentId)
                     + "&user_id=16622"
                     + "&order_search_flg=1"
                     + "&order_search_code=1"
                     + "&order_search_name="
                     + "&_t=" + new Date().getTime()
                     + "#top";
        try {
            ie.Navigate(shohoUrl);
            setTimeout(waitForShohoLoad, 100);
        } catch(e) {
            medOrderCache[paddedId].shohoLoaded = true;
            medOrderCache[paddedId].shohoError = true;
            proceedToChushaOrNext();
        }
        return;
    }

    proceedToChushaOrNext();
}

function waitForShohoLoad() {
    var paddedId = zeroPadId(currentId);
    try {
        if (ie.Busy || ie.readyState !== 4) {
            setTimeout(waitForShohoLoad, 150);
            return;
        }
        var doc = ie.Document;
        medOrderCache[paddedId].shoho = parseMedOrdersFromDoc(doc);
        medOrderCache[paddedId].shohoLoaded = true;
        medOrderCache[paddedId].shohoError = false;
    } catch(e) {
        medOrderCache[paddedId].shoho = [];
        medOrderCache[paddedId].shohoLoaded = true;
        medOrderCache[paddedId].shohoError = true;
    }
    proceedToChushaOrNext();
}

function proceedToChushaOrNext() {
    var paddedId = zeroPadId(currentId);
    if (needChushaTarget() && (!medOrderCache[paddedId].chushaLoaded || medOrderCache[paddedId].chushaError)) {
        document.getElementById("msg").innerText = currentLine + " 行目を処理中... (ID: " + currentId + " の注射歴を取得中)";
        var chushaUrl = "http://10.5.171.42:8082/karte/karte.php"
                      + "?kanja_id=" + encodeURIComponent(currentId)
                      + "&user_id=16622"
                      + "&order_search_flg=1"
                      + "&order_search_code=4"
                      + "&order_search_name="
                      + "&_t=" + new Date().getTime()
                      + "#top";
        try {
            ie.Navigate(chushaUrl);
            setTimeout(waitForChushaLoad, 100);
        } catch(e) {
            medOrderCache[paddedId].chushaLoaded = true;
            medOrderCache[paddedId].chushaError = true;
            proceedToBloodOrFinish();
        }
        return;
    }

    proceedToBloodOrFinish();
}

function waitForChushaLoad() {
    var paddedId = zeroPadId(currentId);
    try {
        if (ie.Busy || ie.readyState !== 4) {
            setTimeout(waitForChushaLoad, 150);
            return;
        }
        var doc = ie.Document;
        medOrderCache[paddedId].chusha = parseMedOrdersFromDoc(doc);
        medOrderCache[paddedId].chushaLoaded = true;
        medOrderCache[paddedId].chushaError = false;
    } catch(e) {
        medOrderCache[paddedId].chusha = [];
        medOrderCache[paddedId].chushaLoaded = true;
        medOrderCache[paddedId].chushaError = true;
    }
    proceedToBloodOrFinish();
}

// 薬剤名から先頭記号（★, ●, （持参薬）等）および末尾の用量・単位・【分割】等を除去
function cleanDrugName(rawLine) {
    if (!rawLine) return "";
    var s = rawLine.replace(/\u00a0/g, " ");
    s = s.replace(/^[\s\u3000]+|[\s\u3000]+$/g, "");
    // 先頭の記号・持参薬表記等を除去
    s = s.replace(/^(?:[★●◎○◆■▲▽▼※]|[\(（]持参薬[\)）]|[\(（]院外[\)）]|[\(（]院内[\)）]|[\s\u3000])+/, "");
    // 末尾の【分割】【一包化】等のタグを除去
    s = s.replace(/\s*【[^】]*】\s*$/g, "");
    // 末尾の「(入院 )?数値+単位」を除去
    s = s.replace(/\s+(?:(?:入院|外来)\s+)?\d+(?:\.\d+)?\s*(?:Ｔ|ＣＰ|カプセル|包|ｇ|ｍｇ|μｇ|ｍＬ|ｍｌ|mL|ml|Ｌ|本|枚|個|管|Ａ|Ｖ|袋|筒|キット|単位|滴|ブリスター|シート|吸入|パフ|押し|錠|丸|パック|セット|瓶|バイアル|アンプル)[^\s]*\s*$/i, "");
    s = s.replace(/^[\s\u3000]+|[\s\u3000]+$/g, "");
    return s;
}

// HTML文字列からタグ除去・主要実体参照デコード
function stripHtmlTags(htmlStr) {
    if (!htmlStr) return "";
    return htmlStr
        .replace(/<br\s*\/?>/gi, "\n")
        .replace(/<[^>]+>/g, "")
        .replace(/&nbsp;/gi, " ")
        .replace(/&lt;/gi, "<")
        .replace(/&gt;/gi, ">")
        .replace(/&amp;/gi, "&")
        .replace(/&quot;/gi, '"');
}

// <TR>内部のHTML文字列から全<TD>/<TH>のテキスト配列をメモリ上で高速抽出
function extractRowCellsFromTrHtml(trHtml) {
    var cells = [];
    if (!trHtml) return cells;
    var closeTr = trHtml.search(/<\/tr>/i);
    var rowBody = (closeTr !== -1) ? trHtml.substring(0, closeTr) : trHtml;
    var tdRe = /<t[dh]\b[^>]*>([\s\S]*?)<\/t[dh]>/gi;
    var m;
    while ((m = tdRe.exec(rowBody)) !== null) {
        cells.push(trimStr(stripHtmlTags(m[1])));
    }
    return cells;
}

// 処方・注射ページのDOMからRp単位で { orderDate, effectiveEndDate, drugs: [...] } を抽出
// ※ getElementsByTagName("*") による数千回のプロセス間COMアクセスを廃止し、innerHTMLの1回取得で高速解析
function parseMedOrdersFromDoc(doc) {
    var orders = [];
    if (!doc || !doc.body) return orders;

    var bodyHtml = doc.body.innerHTML || "";
    if (!bodyHtml) return orders;

    var preChunks = bodyHtml.split(/<pre\b[^>]*>/i);
    var lastHeaderTxt = "";
    var lastHeaderDate = "";

    for (var i = 1; i < preChunks.length; i++) {
        // 直前のチャンクから <SPAN>【...】... YYYY/MM/DD</SPAN> ヘッダを抽出
        var prevHtml = preChunks[i - 1];
        var spanRe = /<span\b[^>]*>([\s\S]*?)<\/span>/gi;
        var sm;
        while ((sm = spanRe.exec(prevHtml)) !== null) {
            var sTxt = trimStr(stripHtmlTags(sm[1]));
            if (sTxt.indexOf("【") !== -1) {
                var dm = sTxt.match(/(\d{4}\/\d{2}\/\d{2})\s*$/);
                if (dm) {
                    lastHeaderTxt = sTxt;
                    lastHeaderDate = dm[1];
                }
            }
        }

        var curChunk = preChunks[i];
        var closeIdx = curChunk.search(/<\/pre>/i);
        var rawPreHtml = (closeIdx !== -1) ? curChunk.substring(0, closeIdx) : curChunk;
        var preTxt = stripHtmlTags(rawPreHtml);
        if (!preTxt) continue;

        // オーダー全体が[中止]または×の場合はスキップ
        if (lastHeaderTxt.indexOf("[中止]") !== -1 || lastHeaderTxt.indexOf("×") !== -1) {
            continue;
        }

        var preLines = preTxt.split(/\r?\n/);
        var orderDate = lastHeaderDate;
        var orderCancelled = false;

        // PRE先頭部のオーダー日・中止判定を確認
        for (var p = 0; p < preLines.length; p++) {
            var pl = trimStr(preLines[p]);
            if (/^Rp\d+/.test(pl)) break;
            if (!orderDate) {
                var pdm = pl.match(/^(\d{4}\/\d{2}\/\d{2})/);
                if (pdm) orderDate = pdm[1];
            }
            if (/No\.\d+\s+中止/.test(pl)) {
                orderCancelled = true;
            }
        }
        if (orderCancelled || !orderDate) continue;

        // Rpブロックごとに分割して解析
        var inRp = false;
        var rpDrugs = [];
        var rpDuration = 1;
        var rpStopDate = "";

        for (var p = 0; p <= preLines.length; p++) {
            var rawL = (p < preLines.length) ? preLines[p] : "Rp999999";
            var trimmedL = trimStr(rawL);

            if (/^Rp\d+/.test(trimmedL)) {
                if (inRp && rpDrugs.length > 0) {
                    var effEnd = addDaysStr(orderDate, (rpDuration > 1 ? rpDuration - 1 : 0));
                    var skipRp = false;
                    if (rpStopDate) {
                        if (rpStopDate <= orderDate) {
                            skipRp = true;
                        } else {
                            var stopPrev = addDaysStr(rpStopDate, -1);
                            if (stopPrev < effEnd) effEnd = stopPrev;
                        }
                    }
                    if (!skipRp) {
                        orders.push({
                            orderDate: orderDate,
                            effectiveEndDate: effEnd,
                            drugs: rpDrugs
                        });
                    }
                }
                inRp = true;
                rpDrugs = [];
                rpDuration = 1;
                rpStopDate = "";
                continue;
            }

            if (!inRp) continue;

            // 全角スペース1個で始まる行＝薬剤名行
            if (/^\u3000[^\s\u3000]/.test(rawL)) {
                var dName = cleanDrugName(rawL);
                if (dName && dName.indexOf("----") === -1) {
                    rpDrugs.push(dName);
                }
            } else if (/^\u3000{2}/.test(rawL)) {
                // 用法・日数行（例: 　　分２　(朝・夕)食後    14日分）
                var durMatch = rawL.match(/(\d+)\s*日分/);
                if (durMatch) {
                    var dNum = parseInt(durMatch[1], 10);
                    if (!isNaN(dNum) && dNum > rpDuration) {
                        rpDuration = dNum;
                    }
                }
                // 【中止】YYYY年MM月DD日
                var stopMatch = rawL.match(/【中止】\s*(\d{4})年(\d{1,2})月(\d{1,2})日/);
                if (stopMatch) {
                    rpStopDate = padDateStr(stopMatch[1] + "/" + stopMatch[2] + "/" + stopMatch[3]);
                }
            }
        }
    }

    return orders;
}

function getMedItemValue(colName) {
    var paddedId = zeroPadId(currentId);
    var mCache = medOrderCache[paddedId];
    if (!mCache) return "";

    var useShoho = (colName === "併用薬" || colName === "処方薬" || colName === "内服薬" || colName === "処方" || isMedSearchItem(colName));
    var useChusha = (colName === "併用薬" || colName === "注射薬" || colName === "注射" || isMedSearchItem(colName));

    if ((useShoho && mCache.shohoError) && (useChusha && mCache.chushaError)) {
        return "薬剤取得エラー";
    }

    var startDate = "";
    if (medSearchDays !== "" && !isNaN(medSearchDays)) {
        startDate = getPastDateStr(currentTargetDate, medSearchDays);
    }

    var combinedOrders = [];
    if (useShoho && mCache.shoho) {
        combinedOrders = combinedOrders.concat(mCache.shoho);
    }
    if (useChusha && mCache.chusha) {
        combinedOrders = combinedOrders.concat(mCache.chusha);
    }

    // 基準日・探索期間（＋処方日数による継続期間）に合致する薬剤を重複排除して抽出
    var activeDrugs = [];
    var seen = {};
    for (var i = 0; i < combinedOrders.length; i++) {
        var ord = combinedOrders[i];
        if (ord.orderDate > currentTargetDate) continue;
        if (startDate !== "" && ord.effectiveEndDate < startDate) continue;

        for (var d = 0; d < ord.drugs.length; d++) {
            var drugName = ord.drugs[d];
            if (!seen[drugName]) {
                seen[drugName] = true;
                activeDrugs.push(drugName);
            }
        }
    }

    // 「併用薬」「処方薬」「注射薬」等の全件出力列の場合
    if (isMedAllItem(colName)) {
        if (activeDrugs.length === 0) return "なし";
        return activeDrugs.join(", ");
    }

    // 「薬剤:フィブラート」「薬剤:ARB」「薬剤:アムロジピン|ノルバスク」等のキーワードサーチ列の場合（辞書による自動展開対応）
    var kwPart = colName.replace(/^(?:併用薬|薬剤|薬)[:：]/, "");
    var keywords = expandSearchKeywords(kwPart);
    var matchedDrugs = [];
    for (var j = 0; j < activeDrugs.length; j++) {
        var aName = activeDrugs[j];
        var normAName = normalizeItemName(aName);
        for (var m = 0; m < keywords.length; m++) {
            var kw = trimStr(keywords[m]);
            if (!kw) continue;
            var normKw = normalizeItemName(kw);
            if (aName.indexOf(kw) !== -1 || (normKw && normAName.indexOf(normKw) !== -1)) {
                matchedDrugs.push(aName);
                break;
            }
        }
    }
    return matchedDrugs.join(", ");
}

function proceedToBloodOrFinish() {
    // 採血項目がない場合（年齢・病名・併用薬のみ取得など）は採血URLへアクセスせず即出力
    if (!hasBloodTestTarget()) {
        buildAndPushRow({});
        updatePreview();
        setTimeout(processNext, 30);
        return;
    }

    document.getElementById("msg").innerText = currentLine + " 行目を処理中... (ID: " + currentId + " の採血結果を取得中)";

    // ★ 探索日数が指定されていれば計算し、空欄なら開始日を "1990/01/01"（事実上の無制限）にする
    // ※ kentai_kekka_menu.php の仕様上、期間指定モード(kentai_disp_flgs先頭=0)では開始日・終了日の両方が必須のため
    var startDate = "1990/01/01";
    if (searchDays !== "" && !isNaN(searchDays)) {
        startDate = getPastDateStr(currentTargetDate, searchDays); 
    }
    var endDate = currentTargetDate;

    // kentai_kekka_menu.php の MakeKentaiDispFlgs() 仕様に基づくフラグ文字列:
    // [0] disp_kensu_gentei_flg = 0 (0:日付期間指定を有効化 / 1:件数限定・日付期間は無視される)
    // [1] disp_koumoku_name_kind = 1 (カタカナ・英数字を半角で表示)
    // [2] disp_column = 11101 (単位:1, 参考値:1, 判定:1, コメント:0, 日付:1)
    // [3] disp_result_order_kind = 1 (降順: 新しい日付が左)
    // [4] disp_graph_order_kind = 1
    // [5] disp_main_value_kind = 1
    // [6] disp_date_kind = 0 (YYYY/MM/DD 4桁年表記)
    // [7] disp_result_set_code = 1 (00.全件)
    // [8] select_section_code_str = ""
    // [9] disp_only_login_user = 0
    // [10] disp_row_flgtbl = 00
    var dispFlgs = "0/1/11101/1/1/1/0/1//0/00";

    var url = "http://10.5.171.42:8082/karte/kentai_kekka_karte.php"
            + "?kanja_id=" + currentId
            + "&user_id=16622"
            + "&section_code=0000023"
            + "&kentai_disp_flgs=" + dispFlgs
            + "&disp_kekka_start_date=" + startDate
            + "&disp_kekka_end_date=" + endDate
            + "&disp_zoom=80"
            + "&disp_kensu_count=9999"
            + "&disp_koumoku_name_kind=1"
            + "&disp_column_tani=1"
            + "&disp_column_sankouchi=1"
            + "&disp_column_hantei=1"
            + "&disp_column_date=1"
            + "&disp_result_order_kind=1"
            + "&disp_graph_order_kind=1"
            + "&disp_main_value_kind=1"
            + "&disp_date_kind=0"
            + "&disp_result_set_code=1"
            + "&_t=" + new Date().getTime();

    try {
        ie.Navigate(url);
        setTimeout(waitForIeLoad, 100);
    } catch(e) {
        appendErrorRow("IE制御エラー");
        setTimeout(processNext, 10);
    }
}

// 検体検査の日付列文字列（例: "2026/10/25", "26/10/25", "2026/10/25(1)" 等）から YYYY/MM/DD を抽出
function extractLabDateStr(rawDateTxt) {
    if (!rawDateTxt) return "";
    var s = trimStr(rawDateTxt);
    var m4 = s.match(/(\d{4})[\/\-年](\d{1,2})[\/\-月](\d{1,2})/);
    if (m4) {
        return padDateStr(m4[1] + "/" + m4[2] + "/" + m4[3]);
    }
    var m2 = s.match(/(\d{2})[\/\-](\d{1,2})[\/\-](\d{1,2})/);
    if (m2) {
        var yr = parseInt(m2[1], 10);
        var fullYr = (yr >= 70 ? "19" : "20") + m2[1];
        return padDateStr(fullYr + "/" + m2[2] + "/" + m2[3]);
    }
    return "";
}

function waitForIeLoad() {
    try {
        if (ie.Busy || ie.readyState !== 4) {
            setTimeout(waitForIeLoad, 200);
            return;
        }
        
        var doc = ie.Document;
        // ★高速化: 疾患・薬剤と同様に、表示された検査結果HTMLを1回で一括取得し、メモリ上で必要な箇所だけ探索する
        var bodyHtml = (doc && doc.body) ? (doc.body.innerHTML || "") : "";
        
        if (!bodyHtml || bodyHtml.indexOf("<table") === -1 && bodyHtml.indexOf("<TABLE") === -1) {
            appendErrorRow("データなし");
        } else {
            var trChunks = bodyHtml.split(/<tr\b[^>]*>/i);
            var dateCols = [];
            var zenkenRowIdx = -1;

            // 1. 「全件」行を探し、日付列を取得
            for (var r = 1; r < trChunks.length; r++) {
                var firstCellMatch = trChunks[r].match(/<t[dh]\b[^>]*>([\s\S]*?)<\/t[dh]>/i);
                if (!firstCellMatch) continue;
                var firstCellTxt = trimStr(stripHtmlTags(firstCellMatch[1]));
                if (firstCellTxt === "全件") {
                    zenkenRowIdx = r;
                    var dCells = extractRowCellsFromTrHtml(trChunks[r]);
                    for (var c = 3; c < dCells.length; c += 2) {
                        var dText = dCells[c];
                        if (dText) {
                            var normD = extractLabDateStr(dText);
                            dateCols.push({
                                colIdx: c,
                                dateStr: dText,
                                normDate: normD || dText
                            });
                        }
                    }
                    break;
                }
            }

            // 基準日・探索期間によるフィルタリング用開始日
            var filterStartDate = "";
            if (searchDays !== "" && !isNaN(searchDays)) {
                filterStartDate = getPastDateStr(currentTargetDate, searchDays);
            }

            // 日付列を基準日に近い順（新しい順＝降順）にソートして探索対象列を確定
            var validDateCols = [];
            for (var dc = 0; dc < dateCols.length; dc++) {
                var dcItem = dateCols[dc];
                if (/^\d{4}\/\d{2}\/\d{2}$/.test(dcItem.normDate)) {
                    if (dcItem.normDate > currentTargetDate) continue;
                    if (filterStartDate !== "" && dcItem.normDate < filterStartDate) continue;
                }
                validDateCols.push(dcItem);
            }
            validDateCols.sort(function(a, b) {
                if (a.normDate > b.normDate) return -1;
                if (a.normDate < b.normDate) return 1;
                return a.colIdx - b.colIdx;
            });

            var valueMap = {};
            if (validDateCols.length > 0) {
                // 見出しで指定された採血項目のマップを作成
                var reqLabMap = {};
                for (var ti = 0; ti < targetItems.length; ti++) {
                    var reqRaw = targetItems[ti];
                    if (isProfileItem(reqRaw) || isByomeiItem(reqRaw) || isMedItem(reqRaw)) continue;
                    var isHist = isHistoryItem(reqRaw);
                    var sItem = reqRaw.replace("全期間", "").replace("全履歴", "");
                    var nReq = normalizeItemName(sItem);
                    if (nReq) {
                        if (!reqLabMap[nReq]) reqLabMap[nReq] = { needHistory: false };
                        if (isHist) reqLabMap[nReq].needHistory = true;
                    }
                    if (sItem) {
                        if (!reqLabMap[sItem]) reqLabMap[sItem] = { needHistory: false };
                        if (isHist) reqLabMap[sItem].needHistory = true;
                    }
                }

                // 2. メモリ上の各行の先頭セル（項目名）だけを確認し、必要な項目の行だけセルを展開して値を抽出
                var startRow = (zenkenRowIdx !== -1) ? zenkenRowIdx + 1 : 1;
                for (var i = startRow; i < trChunks.length; i++) {
                    var fMatch = trChunks[i].match(/<t[dh]\b[^>]*>([\s\S]*?)<\/t[dh]>/i);
                    if (!fMatch) continue;
                    var itemName = trimStr(stripHtmlTags(fMatch[1]));
                    if (itemName === "" || itemName === "全件" || itemName === "検査項目") continue;

                    var normKey = normalizeItemName(itemName);
                    var reqInfo = reqLabMap[normKey] || reqLabMap[itemName];
                    if (!reqInfo) continue; // 要求されていない検査項目行はセル展開せず即スキップ

                    var rowCells = extractRowCellsFromTrHtml(trChunks[i]);
                    if (rowCells.length <= 3) continue;

                    var needHist = reqInfo.needHistory || (reqLabMap[normKey] && reqLabMap[normKey].needHistory) || (reqLabMap[itemName] && reqLabMap[itemName].needHistory);
                    var itemLatestVal = "";
                    var itemLatestDate = "";
                    var itemLatestNormDate = "";
                    var historyArr = [];
                    var historyMap = {};

                    for (var d = 0; d < validDateCols.length; d++) {
                        var col = validDateCols[d].colIdx;
                        var valTxt = (col < rowCells.length) ? rowCells[col] : "";
                        if (valTxt !== "") {
                            var dateTxt = validDateCols[d].dateStr;
                            var normDateTxt = validDateCols[d].normDate;
                            if (itemLatestVal === "") {
                                itemLatestVal = valTxt;
                                itemLatestDate = dateTxt;
                                itemLatestNormDate = normDateTxt;
                                if (!needHist) {
                                    break;
                                }
                            }
                            var hEntry = dateTxt + ": " + valTxt;
                            if (!historyMap[hEntry]) {
                                historyMap[hEntry] = true;
                                historyArr.push(hEntry);
                            }
                        }
                    }

                    var dataObj = {
                        latest: itemLatestVal,
                        latestDate: itemLatestDate,
                        latestNormDate: itemLatestNormDate,
                        historyArr: historyArr,
                        history: historyArr.join(", ")
                    };

                    mergeLabDataObj(valueMap, normKey, dataObj);
                    if (itemName !== normKey) {
                        mergeLabDataObj(valueMap, itemName, dataObj);
                    }
                }
            }

            buildAndPushRow(valueMap, validDateCols);
        }
    } catch(e) {
        appendErrorRow("解析エラー");
    }

    updatePreview();
    setTimeout(processNext, 50);
}

// 複数行に同じ検査項目（旧法と新法など）が存在する場合に、基準日に最も近い測定値を優先してマージする
function mergeLabDataObj(map, key, newObj) {
    if (!key) return;
    var existing = map[key];
    if (!existing) {
        map[key] = {
            latest: newObj.latest,
            latestDate: newObj.latestDate,
            latestNormDate: newObj.latestNormDate,
            historyArr: newObj.historyArr.slice(0),
            history: newObj.history
        };
        return;
    }

    // 新しい行に値があり、既存が空か、新しい行の方が基準日に近い（新しい日付）場合は採用
    if (newObj.latest !== "") {
        if (existing.latest === "" || (newObj.latestNormDate && existing.latestNormDate && newObj.latestNormDate > existing.latestNormDate)) {
            existing.latest = newObj.latest;
            existing.latestDate = newObj.latestDate;
            existing.latestNormDate = newObj.latestNormDate;
        }
    }

    // 履歴の結合（重複排除）
    var seenH = {};
    for (var i = 0; i < existing.historyArr.length; i++) {
        seenH[existing.historyArr[i]] = true;
    }
    for (var j = 0; j < newObj.historyArr.length; j++) {
        var h = newObj.historyArr[j];
        if (!seenH[h]) {
            seenH[h] = true;
            existing.historyArr.push(h);
        }
    }
    existing.history = existing.historyArr.join(", ");
}

function getProfileItemValue(colName) {
    var paddedId = zeroPadId(currentId);
    var pInfo = patientInfoCache[paddedId];
    if (!pInfo || !pInfo.found) return "該当なし";
    if (colName === "生年月日") return pInfo.birthDate || "";
    if (colName === "性別") return pInfo.sex || "";
    if (colName === "年齢") {
        var calc = calculateAge(pInfo.birthDate, currentTargetDate);
        return calc !== "" ? calc : (pInfo.listAge || "");
    }
    return "";
}

function buildAndPushRow(valueMap, dateCols) {
    var rawInputDate = trimStr(currentCols[1]);
    var outRow = [currentId, rawInputDate]; 
    
    for (var k = 0; k < targetItems.length; k++) {
        var reqItemRaw = targetItems[k];
        if (isProfileItem(reqItemRaw)) {
            outRow.push(getProfileItemValue(reqItemRaw));
            continue;
        }
        if (isByomeiItem(reqItemRaw)) {
            outRow.push(getByomeiItemValue(reqItemRaw));
            continue;
        }
        if (isMedItem(reqItemRaw)) {
            outRow.push(getMedItemValue(reqItemRaw));
            continue;
        }

        var searchItem = reqItemRaw;
        var isHistory = false;

        if (searchItem.indexOf("全期間") !== -1) {
            isHistory = true;
            searchItem = searchItem.replace("全期間", "");
        } else if (searchItem.indexOf("全履歴") !== -1) {
            isHistory = true;
            searchItem = searchItem.replace("全履歴", "");
        }
        
        var normReq = normalizeItemName(searchItem);
        var valObj = valueMap[normReq] || valueMap[searchItem];
        
        if (isHistory) {
            if (!valObj || !valObj.history) {
                outRow.push("結果なし");
            } else {
                outRow.push(valObj.history);
            }
        } else {
            var finalDate = "";
            var finalVal = "";

            if (!valObj || valObj.latest === "") {
                finalDate = "結果なし";
                finalVal = "";
            } else {
                finalDate = valObj.latestDate || "結果なし";
                finalVal = valObj.latest; 
            }

            outRow.push(finalVal);
            outRow.push(finalDate);
        }
    }
    outputLines.push(outRow.join("\t"));
}

function appendErrorRow(errMsg) {
    var rawInputDate = trimStr(currentCols[1]);
    var outRow = [currentId, rawInputDate]; 
    for (var k = 0; k < targetItems.length; k++) {
        var reqItemRaw = targetItems[k];
        if (isProfileItem(reqItemRaw)) {
            outRow.push(getProfileItemValue(reqItemRaw));
        } else if (isByomeiItem(reqItemRaw)) {
            outRow.push(getByomeiItemValue(reqItemRaw));
        } else if (isMedItem(reqItemRaw)) {
            outRow.push(getMedItemValue(reqItemRaw));
        } else if (isHistoryItem(reqItemRaw)) {
            outRow.push(errMsg);
        } else {
            outRow.push("");
            outRow.push(errMsg);
        }
    }
    outputLines.push(outRow.join("\t"));
    updatePreview();
}
</script>
<style>
    body { font-family: 'Meiryo UI', sans-serif; background-color: #f4f6f9; padding: 15px; font-size: 13px; }
    textarea { width: 100%; height: 120px; font-size: 12px; font-family: 'MS Gothic', monospace; white-space: pre; word-wrap: normal; overflow-x: scroll; overflow-y: auto; border: 1px solid #ccc; padding: 5px; box-sizing: border-box; }
    button { padding: 8px 20px; font-size: 14px; cursor: pointer; font-weight: bold; background-color: #0078D7; color: white; border: none; border-radius: 3px; }
    button:disabled { background-color: #ccc; cursor: not-allowed; }
    #pauseBtn { background-color: #f57c00; margin-left: 8px; }
    #pauseBtn:disabled { background-color: #ccc; }
    #copyBtn { background-color: #2e7d32; margin-left: 8px; }
    #copyBtn:disabled { background-color: #ccc; }
    .control-panel { background-color: #fff; padding: 12px; border: 1px solid #ddd; margin-bottom: 10px; line-height: 1.8; }
</style>
</head>
<body>
    <h3 style="margin-top:0; color: #333; margin-bottom: 10px;">採血データ・年齢・有効病名・併用薬 一括取得ツール</h3>
    
    <div class="control-panel">
        <div>
            <label>
                <b>採血の探索期間: </b>
                <input type="number" id="searchDays" value="" placeholder="無制限" style="width: 65px; padding: 2px;"> 日前まで
            </label>
            <label style="margin-left: 18px;">
                <b>併用薬の探索期間: </b>
                <input type="number" id="medSearchDays" value="30" placeholder="無制限" style="width: 65px; padding: 2px;"> 日前まで（処方日数も加味）
            </label>
        </div>
        <div style="margin-top: 4px;">
            <label style="cursor: pointer;">
                <input type="checkbox" id="fetchAgeChk" checked>
                <b>年齢も同時に取得</b>
            </label>
            <label style="margin-left: 16px; cursor: pointer;">
                <input type="checkbox" id="fetchByomeiChk" checked>
                <b>有効病名（併存疾患）も同時に取得</b>
            </label>
            <label style="margin-left: 16px; cursor: pointer;">
                <input type="checkbox" id="excludeSuspectedChk">
                <b>「疑い病名（疑＝○）」を除外</b>
            </label>
            <label style="margin-left: 16px; cursor: pointer;">
                <input type="checkbox" id="fetchMedChk" checked>
                <b>併用薬（処方・注射）も同時に取得</b>
            </label>
        </div>
        <div style="margin-top: 4px;">
            <label style="cursor: pointer;">
                <input type="checkbox" id="autoCopyChk">
                <b>完了・一時停止時に自動でクリップボードへコピーする</b>
            </label>
            <button type="button" id="toggleDictBtn" onclick="toggleDictPanel()" style="margin-left: 16px; padding: 3px 10px; font-size: 12px; background-color: #546e7a;">▼ 薬効分類・検索辞書の確認・編集</button>
        </div>
        <div id="dictPanel" style="display: none; margin-top: 8px; padding: 8px; background-color: #f8f9fa; border: 1px solid #cfd8dc; border-radius: 3px;">
            <div style="font-size: 12px; margin-bottom: 4px;">
                <b>薬効分類・検索キーワード辞書</b>（<code>見出し語 = 検索語1, 検索語2, ...</code> の形式で自由に追加・編集できます）:
            </div>
            <textarea id="dictText" wrap="off" style="height: 135px; font-size: 12px; background-color: #fff;"></textarea>
            <div style="margin-top: 5px;">
                <button type="button" onclick="saveDictionary(false)" style="padding: 4px 12px; font-size: 12px; background-color: #0078D7;">辞書を保存</button>
                <button type="button" onclick="resetDictionary()" style="padding: 4px 12px; font-size: 12px; background-color: #78909c; margin-left: 6px;">初期値に戻す</button>
                <span id="dictStatus" style="color: #2e7d32; font-weight: bold; margin-left: 10px; font-size: 12px;"></span>
            </div>
        </div>
        <div style="font-size: 11px; color: #666; margin-top: 6px; border-top: 1px dashed #ddd; padding-top: 5px;">
            ※<b>全病名・全併用薬の収集</b>：上のチェックをONにするか、見出し（1行目）に<b>「有効病名」「併存疾患」</b>や<b>「併用薬」</b>（処方のみは<b>「処方薬」</b>、注射のみは<b>「注射薬」</b>）と入力すると、重複排除して1セルにまとめて出力します。<br>
            ※<b>特定疾患・特定薬剤・薬効分類サーチ</b>：見出しに<b>「薬剤:フィブラート」「薬剤:ARB」「薬剤:SGLT2」「薬剤:DPP4」「薬剤:PPI」「薬剤:ビスホスホネート」「薬剤:スタチン」</b>や<b>「病名:糖尿病」</b>と入力すると、辞書登録された先発品・後発品・配合剤も含めて自動展開して抽出します（複数指定は <code>|</code> 区切り）。<br>
            ※<b>併用薬の判定</b>：基準日以前のオーダーのうち、探索期間内の処方・注射に加え、長期処方（例：60日分）で基準日時点も服用継続中の薬剤を自動判定します（[中止]オーダーや服用中止分は自動除外）。<br>
            ※<b>全期間採血</b>：見出しに<b>「eGFR全期間」</b>のように<b>「全期間」</b>をつけると、採血日列を作らずに対象期間の履歴を1セルにまとめて出力します。
        </div>
    </div>

    <textarea id="inputText" wrap="off" placeholder="ここにJUSTcalcのデータ（1行目の見出しを含む）を貼り付けてください"></textarea>
    
    <div style="margin-top: 10px;">
        <button id="btn" onclick="startProcess()">一覧から一括取得開始</button>
        <button id="pauseBtn" onclick="togglePause()" disabled>一時停止</button>
        <button id="copyBtn" onclick="copyResult()" disabled>取得結果をコピー</button>
        <span id="msg" style="color: #d32f2f; font-weight: bold; margin-left: 15px;">待機中...</span>
        <span id="copyStatus" style="color: #2e7d32; font-weight: bold; margin-left: 10px;"></span>
    </div>

    <div style="margin-top: 15px; margin-bottom: 4px; color: #333;">
        <b>結果プレビュー</b><span id="previewCount" style="font-size: 12px; color: #555;"></span>:
        <label style="margin-left: 15px; font-weight: normal; font-size: 12px; cursor: pointer;">
            <input type="checkbox" id="showAllPreviewChk" checked onchange="updatePreview()"> 全件表示する（オフで先頭5行のみ表示）
        </label>
    </div>
    <textarea id="previewText" wrap="off" readonly style="background-color: #f0f0f0; height: 220px;" placeholder="ここに実行結果がリアルタイムで全件表示されます（手動で範囲選択してコピーすることも可能です）"></textarea>

</body>
</html>